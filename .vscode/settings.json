{
    "code-runner.runInTerminal": true,
    "code-runner.clearPreviousexeput": true,
    "code-runner.saveFileBeforeRun": true,
    "code-runner.ignoreSelection": true,
    "code-runner.preserveFocus": false,
    "code-runner.fileDirectoryAsCwd": true,
    
    "code-runner.executorMap": {
        "cpp": "cd $dir && g++ -Wall -Wextra -pedantic -std=c++17 $fileName -o $fileNameWithoutExt && ./$fileNameWithoutExt",
        "c": "cd $dir && gcc -Wall -Wextra -pedantic -std=c11 $fileName -o $fileNameWithoutExt && ./$fileNameWithoutExt"
    }
}
