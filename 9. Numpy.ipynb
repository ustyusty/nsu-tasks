    "#### 23. Рассмотрим произвольный двумерный массив. Напишите функцию, которая извлекает двумерный подмассив с фиксированной формой и центрирует его по заданному элементу (при необходимости дополните значением \"fill\").  \n",
    "Эта задача очень распространена в CV (компьютерном зрении), когда необходимо двигаться по картинке с окном заданного размера и применять к элементам окна разные агрегатные функции.  "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 105,
   "id": "fd3ec2e0",
   "metadata": {},
   "outputs": [],
   "source": [
    "def center_of_sub_arr(arr: np.ndarray, center_x: int, center_y: int, size_x:int, size_y:int) -> np.ndarray:\n",
    "    sub_arr = np.zeros((size_y, size_x), dtype=arr.dtype)\n",
    "    new_arr = arr[int(center_y-size_y/2):int(center_y+size_y/2), int(center_x-size_x/2):int(center_x+size_x/2)]\n",
    "    sub_arr[:new_arr.shape[0],:new_arr.shape[1]] = new_arr\n",
    "    return sub_arr"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 307,
   "id": "a7714cff",
   "metadata": {
    "ExecuteTime": {
