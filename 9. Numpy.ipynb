    "vecA = np.random.randint(0,20, 10)\n",
    "vecB = np.random.randint(0,20, 10)\n",
    "res_sum = np.einsum('i->', vecA)\n",
    "res_mul = np.einsum('i,i->i', vecA, vecB)\n",
    "res_inner = np.einsum('i,i->', vecA, vecB)\n",
    "res_outer = np.einsum('i,j->ij', vecA, vecB)\n",
    "print(f\"\\\n",
    "    vecA: {vecA}\\n\\\n",
    "    vecB: {vecB}\\n\\\n",
    "    sum A: {res_sum}\\n\\\n",
    "    {np.sum(vecA)}\\n\\\n",
