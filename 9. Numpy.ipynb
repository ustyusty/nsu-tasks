    "import time\n",
    "vec = np.random.random(100000000)\n",
    "\n",
    "def check_time(func: function): \n",
    "    arr =[]\n",
    "    for _ in range(11):\n",
    "        start_time = time.perf_counter()\n",
    "        d = func(vec, 3)\n",
    "        end_time = time.perf_counter()\n",
    "        arr.append(end_time - start_time)\n",
    "    arr.sort()\n",
    "    print(f\"Время выполнения по медиане: {arr[5]} секунд\")\n",
    "    print(d)\n",
    "\n",
    "def pow(v, s):\n",
    "    return v**s\n",
    "\n",
    "def mul(v, s):\n",
    "    return v*v*v\n",
    "\n",
    "check_time(pow)\n",
    "check_time(np.pow)\n",
    "check_time(mul)\n"
   ]
